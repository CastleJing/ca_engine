{
	"actor-a10-name": "A10 Bomber",
	"actor-afld.description": "Provides a dropzone Provides a dropzone for vehicle reinforcements.",
	"actor-afld.encyclopedia": "Delivers vehicles by plane for Nod. Nod vehicles are fast but fragile. Produce harvesters at the start to jumpstart your economy. Delivers vehicles by plane for Nod. Nod vehicles are fast but fragile. Produce harvesters at the start to jumpstart your economy.",
